//! Enhanced Session lifecycle management with graceful shutdown and resource leak detection
//!
//! This module provides robust session management functionality for executing session-typed
//! protocols, including graceful shutdown mechanisms, resource tracking, and leak detection.

use std::collections::HashMap;
use std::fmt;
use std::sync::Arc;
use std::time::{Duration, Instant, SystemTime};
use tokio::sync::{RwLock, Mutex, watch, mpsc};
use tokio::task::JoinHandle;
use tokio::time::timeout;
use uuid::Uuid;

use crate::protocol::foundation::{ActionIOTMarker, LocalProtocol, Role, SupportsActionIO};
use crate::runtime::{
    error::RuntimeError,
    state::{ProtocolState, ExecutionContext},
    channel::{TypedChannel, ChannelConfig, ChannelId},
};

/// Unique identifier for a session
#[derive(Debug, Clone, PartialEq, Eq, Hash)]
pub struct SessionId(pub String);

impl SessionId {
    pub fn new(id: impl Into<String>) -> Self {
        Self(id.into())
    }

    pub fn generate() -> Self {
        Self(Uuid::new_v4().to_string())
    }
}

impl fmt::Display for SessionId {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        write!(f, "{}", self.0)
    }
}

/// Status of a session
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum SessionStatus {
    /// Session is initializing
    Initializing,
    /// Session is actively running
    Running,
    /// Session is paused (can be resumed)
    Paused,
    /// Session is shutting down gracefully
    ShuttingDown,
    /// Session completed successfully
    Completed,
    /// Session failed with an error
    Failed(String),
    /// Session was cancelled
    Cancelled,
}

impl fmt::Display for SessionStatus {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            SessionStatus::Initializing => write!(f, "Initializing"),
            SessionStatus::Running => write!(f, "Running"),
            SessionStatus::Paused => write!(f, "Paused"),
            SessionStatus::ShuttingDown => write!(f, "ShuttingDown"),
            SessionStatus::Completed => write!(f, "Completed"),
            SessionStatus::Failed(error) => write!(f, "Failed: {}", error),
            SessionStatus::Cancelled => write!(f, "Cancelled"),
        }
    }
}

/// Shutdown configuration for sessions
#[derive(Debug, Clone)]
pub struct ShutdownConfig {
    /// Maximum time to wait for graceful shutdown
    pub graceful_shutdown_timeout: Duration,
    /// Maximum time to wait for critical operations to complete
    pub critical_operations_timeout: Duration,
    /// Whether to wait for all tasks to complete or abort them
    pub force_task_termination: bool,
    /// Whether to perform strict resource leak detection
    pub strict_leak_detection: bool,
}

impl Default for ShutdownConfig {
    fn default() -> Self {
        Self {
            graceful_shutdown_timeout: Duration::from_secs(30),
            critical_operations_timeout: Duration::from_secs(5),
            force_task_termination: false,
            strict_leak_detection: true,
        }
    }
}

/// Tracked resource information for leak detection
#[derive(Debug, Clone)]
pub struct TrackedResource {
    pub resource_id: String,
    pub resource_type: ResourceType,
    pub created_at: SystemTime,
    pub is_closed: bool,
}

/// Types of resources that can be tracked
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum ResourceType {
    Channel,
    Task,
    Connection,
    FileHandle,
    Other(String),
}

impl fmt::Display for ResourceType {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            ResourceType::Channel => write!(f, "Channel"),
            ResourceType::Task => write!(f, "Task"),
            ResourceType::Connection => write!(f, "Connection"),
            ResourceType::FileHandle => write!(f, "FileHandle"),
            ResourceType::Other(name) => write!(f, "Other({})", name),
        }
    }
}

/// Resource leak detection report
#[derive(Debug, Clone)]
pub struct LeakDetectionReport {
    pub session_id: SessionId,
    pub leaked_resources: Vec<TrackedResource>,
    pub total_resources_created: usize,
    pub total_resources_closed: usize,
    pub detection_time: SystemTime,
}

impl LeakDetectionReport {
    pub fn has_leaks(&self) -> bool {
        !self.leaked_resources.is_empty()
    }

    pub fn leak_count(&self) -> usize {
        self.leaked_resources.len()
    }
}

/// A session represents an instance of protocol execution with enhanced lifecycle management
pub struct Session<P, R, AIO>
where
    P: LocalProtocol,
    R: Role + SupportsActionIO<AIO>,
    AIO: ActionIOTMarker,
{
    id: SessionId,
    status: Arc<RwLock<SessionStatus>>,
    state: Arc<RwLock<ProtocolState<P>>>,
    context: Arc<RwLock<ExecutionContext<R>>>,
    channel: Arc<TypedChannel<P, R, AIO>>,
    task_handle: Arc<Mutex<Option<JoinHandle<Result<(), RuntimeError>>>>>,
    
    // Enhanced lifecycle management
    shutdown_config: ShutdownConfig,
    shutdown_signal: Arc<watch::Sender<bool>>,
    shutdown_receiver: watch::Receiver<bool>,
    
    // Resource tracking for leak detection
    tracked_resources: Arc<RwLock<HashMap<String, TrackedResource>>>,
    task_handles: Arc<RwLock<HashMap<String, JoinHandle<()>>>>,
    channel_handles: Arc<RwLock<HashMap<ChannelId, Arc<TypedChannel<P, R, AIO>>>>>,
    
    // Logging and metrics
    created_at: SystemTime,
    last_activity: Arc<RwLock<SystemTime>>,
}

impl<P, R, AIO> Session<P, R, AIO>
where
    P: LocalProtocol + Send + Sync + 'static,
    R: Role + SupportsActionIO<AIO> + Send + Sync + 'static,
    AIO: ActionIOTMarker + Send + Sync + 'static,
{
    /// Create a new session with enhanced lifecycle management
    pub fn new(
        id: SessionId,
        protocol: P,
        role: R,
        channel_config: ChannelConfig,
    ) -> (Self, TypedChannel<P, R, AIO>) {
        Self::new_with_config(id, protocol, role, channel_config, ShutdownConfig::default())
    }

    /// Create a new session with custom shutdown configuration
    pub fn new_with_config(
        id: SessionId,
        protocol: P,
        role: R,
        channel_config: ChannelConfig,
        shutdown_config: ShutdownConfig,
    ) -> (Self, TypedChannel<P, R, AIO>) {
        let state = ProtocolState::new(id.clone(), role.clone(), protocol);
        let context = ExecutionContext::new(id.0.clone(), format!("{:?}", role));
        let (channel1, channel2) = TypedChannel::new(channel_config);

        let (shutdown_tx, shutdown_rx) = watch::channel(false);

        let session = Self {
            id,
            status: Arc::new(RwLock::new(SessionStatus::Initializing)),
            state: Arc::new(RwLock::new(state)),
            context: Arc::new(RwLock::new(context)),
            channel: Arc::new(channel1),
            task_handle: Arc::new(Mutex::new(None)),
            shutdown_config,
            shutdown_signal: Arc::new(shutdown_tx),
            shutdown_receiver: shutdown_rx,
            tracked_resources: Arc::new(RwLock::new(HashMap::new())),
            task_handles: Arc::new(RwLock::new(HashMap::new())),
            channel_handles: Arc::new(RwLock::new(HashMap::new())),
            created_at: SystemTime::now(),
            last_activity: Arc::new(RwLock::new(SystemTime::now())),
        };

        (session, channel2)
    }

    /// Get the session ID
    pub fn id(&self) -> &SessionId {
        &self.id
    }

    /// Get the current session status
    pub async fn status(&self) -> SessionStatus {
        self.status.read().await.clone()
    }

    /// Update last activity timestamp
    async fn update_activity(&self) {
        let mut last_activity = self.last_activity.write().await;
        *last_activity = SystemTime::now();
    }

    /// Track a new resource for leak detection
    pub async fn track_resource(&self, resource_id: String, resource_type: ResourceType) {
        let resource = TrackedResource {
            resource_id: resource_id.clone(),
            resource_type,
            created_at: SystemTime::now(),
            is_closed: false,
        };

        let mut resources = self.tracked_resources.write().await;
        resources.insert(resource_id, resource);
        
        log::debug!("Session {}: Tracking new resource: {} ({})", 
                   self.id, resource.resource_id, resource.resource_type);
    }

    /// Mark a resource as closed
    pub async fn close_resource(&self, resource_id: &str) {
        let mut resources = self.tracked_resources.write().await;
        if let Some(resource) = resources.get_mut(resource_id) {
            resource.is_closed = true;
            log::debug!("Session {}: Closed resource: {} ({})", 
                       self.id, resource_id, resource.resource_type);
        }
    }

    /// Track a Tokio task
    pub async fn track_task(&self, task_name: String, handle: JoinHandle<()>) {
        self.track_resource(task_name.clone(), ResourceType::Task).await;
        
        let mut tasks = self.task_handles.write().await;
        tasks.insert(task_name, handle);
    }

    /// Track a channel
    pub async fn track_channel(&self, channel_id: ChannelId, channel: Arc<TypedChannel<P, R, AIO>>) {
        self.track_resource(channel_id.to_string(), ResourceType::Channel).await;
        
        let mut channels = self.channel_handles.write().await;
        channels.insert(channel_id, channel);
    }

    /// Start the session execution
    pub async fn start(&self) -> Result<(), RuntimeError> {
        let mut status = self.status.write().await;
        if *status != SessionStatus::Initializing {
            return Err(RuntimeError::Protocol(
                crate::runtime::error::ProtocolViolation::InvalidTransition {
                    current_state: status.to_string(),
                    action_taken: "start".to_string(),
                    expected_actions_or_states: "Initializing".to_string(),
                }
            ));
        }

        log::info!("Session {}: Starting execution", self.id);
        *status = SessionStatus::Running;
        self.update_activity().await;
        
        // Spawn the session execution task
        let state_arc = Arc::clone(&self.state);
        let context_arc = Arc::clone(&self.context);
        let channel_arc = Arc::clone(&self.channel);
        let status_arc = Arc::clone(&self.status);
        let session_id = self.id.clone();
        let mut shutdown_receiver = self.shutdown_receiver.clone();

        let handle = tokio::spawn(async move {
            Self::execute_session(state_arc, context_arc, channel_arc, status_arc, session_id, shutdown_receiver).await
        });

        let mut task_handle = self.task_handle.lock().await;
        *task_handle = Some(handle);

        // Track the main execution task
        self.track_resource("main_execution".to_string(), ResourceType::Task).await;

        Ok(())
    }

    /// Initiate graceful shutdown of the session
    pub async fn shutdown_graceful(&self) -> Result<(), RuntimeError> {
        let current_status = self.status().await;
        
        if matches!(current_status, SessionStatus::Completed | SessionStatus::Failed(_) | SessionStatus::Cancelled) {
            log::debug!("Session {}: Already in final state: {}", self.id, current_status);
            return Ok(());
        }

        log::info!("Session {}: Initiating graceful shutdown", self.id);

        // Update status to shutting down
        {
            let mut status = self.status.write().await;
            *status = SessionStatus::ShuttingDown;
        }

        // Signal shutdown to all components
        if let Err(_) = self.shutdown_signal.send(true) {
            log::warn!("Session {}: Failed to send shutdown signal", self.id);
        }

        // Wait for graceful shutdown with timeout
        let shutdown_result = timeout(
            self.shutdown_config.graceful_shutdown_timeout,
            self.wait_for_completion()
        ).await;

        match shutdown_result {
            Ok(Ok(())) => {
                log::info!("Session {}: Graceful shutdown completed successfully", self.id);
                Ok(())
            }
            Ok(Err(e)) => {
                log::error!("Session {}: Graceful shutdown failed: {}", self.id, e);
                self.shutdown_force().await
            }
            Err(_) => {
                log::warn!("Session {}: Graceful shutdown timed out, forcing shutdown", self.id);
                self.shutdown_force().await
            }
        }
    }

    /// Force shutdown of the session
    async fn shutdown_force(&self) -> Result<(), RuntimeError> {
        log::warn!("Session {}: Forcing shutdown", self.id);

        // Abort the main task if it exists
        {
            let mut task_handle = self.task_handle.lock().await;
            if let Some(handle) = task_handle.take() {
                handle.abort();
                log::debug!("Session {}: Aborted main execution task", self.id);
            }
        }

        // Abort all tracked tasks if configured to do so
        if self.shutdown_config.force_task_termination {
            let mut tasks = self.task_handles.write().await;
            for (task_name, handle) in tasks.drain() {
                handle.abort();
                log::debug!("Session {}: Aborted task: {}", self.id, task_name);
            }
        }

        // Close all tracked channels
        {
            let mut channels = self.channel_handles.write().await;
            for (channel_id, _channel) in channels.drain() {
                // In a real implementation, we would close the channel here
                log::debug!("Session {}: Closed channel: {}", self.id, channel_id);
                self.close_resource(&channel_id.to_string()).await;
            }
        }

        // Update final status
        {
            let mut status = self.status.write().await;
            *status = SessionStatus::Cancelled;
        }

        Ok(())
    }

    /// Wait for session completion
    async fn wait_for_completion(&self) -> Result<(), RuntimeError> {
        let task_handle = {
            let handle_guard = self.task_handle.lock().await;
            handle_guard.as_ref().map(|h| h.abort_handle())
        };

        if task_handle.is_some() {
            // Wait for status to become final
            loop {
                let status = self.status().await;
                match status {
                    SessionStatus::Completed | SessionStatus::Failed(_) | SessionStatus::Cancelled => {
                        break;
                    }
                    _ => {
                        tokio::time::sleep(Duration::from_millis(10)).await;
                    }
                }
            }
        }

        let final_status = self.status().await;
        match final_status {
            SessionStatus::Completed => Ok(()),
            SessionStatus::Failed(error) => Err(RuntimeError::System { 
                message: format!("Session execution failed: {}", error) 
            }),
            SessionStatus::Cancelled => Err(RuntimeError::System { 
                message: "Session was cancelled".to_string() 
            }),
            _ => Err(RuntimeError::System { 
                message: "Session did not reach final state".to_string() 
            }),
        }
    }

    /// Perform resource leak detection
    pub async fn detect_leaks(&self) -> LeakDetectionReport {
        let resources = self.tracked_resources.read().await;
        let leaked_resources: Vec<TrackedResource> = resources
            .values()
            .filter(|resource| !resource.is_closed)
            .cloned()
            .collect();

        let total_created = resources.len();
        let total_closed = resources.values().filter(|r| r.is_closed).count();

        let report = LeakDetectionReport {
            session_id: self.id.clone(),
            leaked_resources,
            total_resources_created: total_created,
            total_resources_closed: total_closed,
            detection_time: SystemTime::now(),
        };

        if report.has_leaks() {
            if self.shutdown_config.strict_leak_detection {
                log::error!("Session {}: Resource leaks detected: {} leaked resources", 
                           self.id, report.leak_count());
            } else {
                log::warn!("Session {}: Resource leaks detected: {} leaked resources", 
                          self.id, report.leak_count());
            }

            for resource in &report.leaked_resources {
                log::warn!("Session {}: Leaked resource: {} ({})", 
                          self.id, resource.resource_id, resource.resource_type);
            }
        } else {
            log::info!("Session {}: No resource leaks detected", self.id);
        }

        report
    }

    /// Pause the session execution
    pub async fn pause(&self) -> Result<(), RuntimeError> {
        let mut status = self.status.write().await;
        if *status != SessionStatus::Running {
            return Err(RuntimeError::Protocol(
                crate::runtime::error::ProtocolViolation::InvalidTransition {
                    current_state: status.to_string(),
                    action_taken: "pause".to_string(),
                    expected_actions_or_states: "Running".to_string(),
                }
            ));
        }

        log::info!("Session {}: Pausing execution", self.id);
        *status = SessionStatus::Paused;
        self.update_activity().await;
        Ok(())
    }

    /// Resume the session execution
    pub async fn resume(&self) -> Result<(), RuntimeError> {
        let mut status = self.status.write().await;
        if *status != SessionStatus::Paused {
            return Err(RuntimeError::Protocol(
                crate::runtime::error::ProtocolViolation::InvalidTransition {
                    current_state: status.to_string(),
                    action_taken: "resume".to_string(),
                    expected_actions_or_states: "Paused".to_string(),
                }
            ));
        }

        log::info!("Session {}: Resuming execution", self.id);
        *status = SessionStatus::Running;
        self.update_activity().await;
        Ok(())
    }

    /// Cancel the session execution (legacy method for compatibility)
    pub async fn cancel(&self) -> Result<(), RuntimeError> {
        self.shutdown_graceful().await
    }

    /// Wait for the session to complete
    pub async fn wait(&self) -> Result<(), RuntimeError> {
        self.wait_for_completion().await
    }

    /// Internal session execution logic with shutdown awareness
    async fn execute_session(
        state: Arc<RwLock<ProtocolState<P>>>,
        context: Arc<RwLock<ExecutionContext<R>>>,
        _channel: Arc<TypedChannel<P, R, AIO>>,
        status: Arc<RwLock<SessionStatus>>,
        session_id: SessionId,
        mut shutdown_receiver: watch::Receiver<bool>,
    ) -> Result<(), RuntimeError> {
        log::debug!("Session {}: Starting execution loop", session_id);

        // Main execution loop with shutdown awareness
        loop {
            // Check for shutdown signal
            if *shutdown_receiver.borrow_and_update() {
                log::info!("Session {}: Received shutdown signal, terminating execution", session_id);
                break;
            }

            let current_status = {
                let status_guard = status.read().await;
                status_guard.clone()
            };

            match current_status {
                SessionStatus::Running => {
                    // Execute one step of the protocol
                    let transition_result = {
                        let mut state_guard = state.write().await;
                        let context_guard = context.read().await;
                        
                        // Simulate protocol step execution
                        // In a real implementation, this would execute the actual protocol logic
                        state_guard.execute_step(&*context_guard).await
                    };

                    match transition_result {
                        Ok(Some(_transition)) => {
                            // Continue execution
                            tokio::time::sleep(Duration::from_millis(10)).await;
                        }
                        Ok(None) => {
                            // Protocol completed successfully
                            log::info!("Session {}: Protocol execution completed", session_id);
                            let mut status_guard = status.write().await;
                            *status_guard = SessionStatus::Completed;
                            break;
                        }
                        Err(error) => {
                            // Protocol execution failed
                            log::error!("Session {}: Protocol execution failed: {}", session_id, error);
                            let mut status_guard = status.write().await;
                            *status_guard = SessionStatus::Failed(error.to_string());
                            return Err(error);
                        }
                    }
                }
                SessionStatus::Paused => {
                    // Wait while paused
                    tokio::time::sleep(Duration::from_millis(100)).await;
                }
                SessionStatus::ShuttingDown => {
                    // Perform any critical cleanup operations here
                    log::info!("Session {}: Performing critical cleanup operations", session_id);
                    
                    // Simulate critical operations with timeout
                    tokio::time::sleep(Duration::from_millis(50)).await;
                    
                    let mut status_guard = status.write().await;
                    *status_guard = SessionStatus::Completed;
                    break;
                }
                SessionStatus::Cancelled => {
                    // Session was cancelled
                    log::info!("Session {}: Execution cancelled", session_id);
                    return Err(RuntimeError::System { 
                        message: "Session cancelled".to_string() 
                    });
                }
                SessionStatus::Failed(error) => {
                    // Session already failed
                    return Err(RuntimeError::System { 
                        message: format!("Session execution failed: {}", error) 
                    });
                }
                SessionStatus::Completed => {
                    // Session already completed
                    break;
                }
                SessionStatus::Initializing => {
                    // Should not happen in execution
                    return Err(RuntimeError::System { 
                        message: "Session still initializing".to_string() 
                    });
                }
            }

            // Check for shutdown signal with timeout
            if let Ok(result) = tokio::time::timeout(Duration::from_millis(1), shutdown_receiver.changed()).await {
                if result.is_ok() && *shutdown_receiver.borrow_and_update() {
                    log::info!("Session {}: Received shutdown signal, terminating execution", session_id);
                    break;
                }
            }
        }

        log::debug!("Session {}: Execution loop terminated", session_id);
        Ok(())
    }

    /// Get channel reference
    pub fn channel(&self) -> Arc<TypedChannel<P, R, AIO>> {
        Arc::clone(&self.channel)
    }

    /// Get current protocol state (for debugging/monitoring)
    pub async fn get_state(&self) -> ProtocolState<P> {
        self.state.read().await.clone()
    }

    /// Get session metrics for monitoring
    pub async fn get_metrics(&self) -> SessionMetrics {
        let resources = self.tracked_resources.read().await;
        let tasks = self.task_handles.read().await;
        let channels = self.channel_handles.read().await;
        let last_activity = *self.last_activity.read().await;

        SessionMetrics {
            session_id: self.id.clone(),
            status: self.status().await,
            created_at: self.created_at,
            last_activity,
            total_resources: resources.len(),
            active_tasks: tasks.len(),
            active_channels: channels.len(),
            uptime: self.created_at.elapsed().unwrap_or_default(),
        }
    }
}

/// Session metrics for monitoring and debugging
#[derive(Debug, Clone)]
pub struct SessionMetrics {
    pub session_id: SessionId,
    pub status: SessionStatus,
    pub created_at: SystemTime,
    pub last_activity: SystemTime,
    pub total_resources: usize,
    pub active_tasks: usize,
    pub active_channels: usize,
    pub uptime: Duration,
}

impl<P, R, AIO> fmt::Debug for Session<P, R, AIO>
where
    P: LocalProtocol,
    R: Role + SupportsActionIO<AIO>,
    AIO: ActionIOTMarker,
{
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        f.debug_struct("Session")
            .field("id", &self.id)
            .field("protocol", &std::any::type_name::<P>())
            .field("role", &std::any::type_name::<R>())
            .field("action_io", &std::any::type_name::<AIO>())
            .field("created_at", &self.created_at)
            .finish()
    }
}

/// Implement Drop trait for automatic resource cleanup detection
impl<P, R, AIO> Drop for Session<P, R, AIO>
where
    P: LocalProtocol,
    R: Role + SupportsActionIO<AIO>,
    AIO: ActionIOTMarker,
{
    fn drop(&mut self) {
        // Note: We can't use async operations in Drop, but we can log
        log::debug!("Session {} is being dropped", self.id);
        
        // In a real implementation, we might want to schedule cleanup
        // operations using a cleanup task or runtime
    }
}

/// Manager for multiple sessions with enhanced lifecycle management
pub struct SessionManager {
    sessions: RwLock<HashMap<SessionId, Box<dyn SessionHandle>>>,
    default_config: ChannelConfig,
    default_shutdown_config: ShutdownConfig,
}

/// Trait for type-erased session management
trait SessionHandle: Send + Sync {
    fn id(&self) -> &SessionId;
    fn status(&self) -> impl std::future::Future<Output = SessionStatus> + Send;
    fn shutdown_graceful(&self) -> impl std::future::Future<Output = Result<(), RuntimeError>> + Send;
    fn cancel(&self) -> impl std::future::Future<Output = Result<(), RuntimeError>> + Send;
    fn detect_leaks(&self) -> impl std::future::Future<Output = LeakDetectionReport> + Send;
    fn get_metrics(&self) -> impl std::future::Future<Output = SessionMetrics> + Send;
}

impl<P, R, AIO> SessionHandle for Session<P, R, AIO>
where
    P: LocalProtocol + Send + Sync,
    R: Role + SupportsActionIO<AIO> + Send + Sync,
    AIO: ActionIOTMarker + Send + Sync,
{
    fn id(&self) -> &SessionId {
        &self.id
    }

    async fn status(&self) -> SessionStatus {
        self.status().await
    }

    async fn shutdown_graceful(&self) -> Result<(), RuntimeError> {
        self.shutdown_graceful().await
    }

    async fn cancel(&self) -> Result<(), RuntimeError> {
        self.cancel().await
    }

    async fn detect_leaks(&self) -> LeakDetectionReport {
        self.detect_leaks().await
    }

    async fn get_metrics(&self) -> SessionMetrics {
        self.get_metrics().await
    }
}

impl SessionManager {
    /// Create a new session manager
    pub fn new(default_config: ChannelConfig) -> Self {
        Self {
            sessions: RwLock::new(HashMap::new()),
            default_config,
            default_shutdown_config: ShutdownConfig::default(),
        }
    }

    /// Create a new session manager with custom shutdown configuration
    pub fn new_with_shutdown_config(
        default_config: ChannelConfig,
        shutdown_config: ShutdownConfig,
    ) -> Self {
        Self {
            sessions: RwLock::new(HashMap::new()),
            default_config,
            default_shutdown_config: shutdown_config,
        }
    }

    /// Create and register a new session
    pub async fn create_session<P, R, AIO>(
        &self,
        id: SessionId,
        protocol: P,
        role: R,
    ) -> Result<(Arc<Session<P, R, AIO>>, TypedChannel<P, R, AIO>), RuntimeError>
    where
        P: LocalProtocol + Send + Sync + 'static,
        R: Role + SupportsActionIO<AIO> + Send + Sync + 'static,
        AIO: ActionIOTMarker + Send + Sync + 'static,
    {
        let (session, channel) = Session::new_with_config(
            id.clone(), 
            protocol, 
            role, 
            self.default_config.clone(),
            self.default_shutdown_config.clone(),
        );
        let session_arc = Arc::new(session);

        // Register the session
        let mut sessions = self.sessions.write().await;
        if sessions.contains_key(&id) {
            return Err(RuntimeError::System { 
                message: format!("Session {} already exists", id) 
            });
        }

        sessions.insert(id, Box::new(Arc::clone(&session_arc)));
        log::info!("SessionManager: Created new session {}", session_arc.id());

        Ok((session_arc, channel))
    }

    /// Get a session status by ID
    pub async fn get_session_status(&self, id: &SessionId) -> Option<SessionStatus> {
        let sessions = self.sessions.read().await;
        if let Some(session) = sessions.get(id) {
            Some(session.status().await)
        } else {
            None
        }
    }

    /// Get session metrics by ID
    pub async fn get_session_metrics(&self, id: &SessionId) -> Option<SessionMetrics> {
        let sessions = self.sessions.read().await;
        if let Some(session) = sessions.get(id) {
            Some(session.get_metrics().await)
        } else {
            None
        }
    }

    /// Perform graceful shutdown of a session by ID
    pub async fn shutdown_session(&self, id: &SessionId) -> Result<(), RuntimeError> {
        let sessions = self.sessions.read().await;
        if let Some(session) = sessions.get(id) {
            log::info!("SessionManager: Initiating graceful shutdown for session {}", id);
            session.shutdown_graceful().await
        } else {
            Err(RuntimeError::System { 
                message: format!("Session {} not found", id) 
            })
        }
    }

    /// Cancel a session by ID (legacy method for compatibility)
    pub async fn cancel_session(&self, id: &SessionId) -> Result<(), RuntimeError> {
        self.shutdown_session(id).await
    }

    /// Gracefully shutdown all sessions
    pub async fn shutdown_all_sessions(&self) -> Result<(), RuntimeError> {
        let sessions = self.sessions.read().await;
        let mut errors = Vec::new();

        log::info!("SessionManager: Initiating graceful shutdown for {} sessions", sessions.len());

        for session in sessions.values() {
            if let Err(error) = session.shutdown_graceful().await {
                log::error!("SessionManager: Failed to shutdown session {}: {}", 
                           session.id(), error);
                errors.push(error);
            }
        }

        if errors.is_empty() {
            log::info!("SessionManager: All sessions shut down successfully");
            Ok(())
        } else {
            Err(RuntimeError::System { 
                message: format!("Failed to shutdown {} sessions", errors.len()) 
            })
        }
    }

    /// Force cancel all sessions (legacy method for compatibility)
    pub async fn cancel_all_sessions(&self) -> Result<(), RuntimeError> {
        self.shutdown_all_sessions().await
    }

    /// Perform resource leak detection on a specific session
    pub async fn detect_session_leaks(&self, id: &SessionId) -> Option<LeakDetectionReport> {
        let sessions = self.sessions.read().await;
        if let Some(session) = sessions.get(id) {
            Some(session.detect_leaks().await)
        } else {
            None
        }
    }

    /// Perform resource leak detection on all sessions
    pub async fn detect_all_leaks(&self) -> Vec<LeakDetectionReport> {
        let sessions = self.sessions.read().await;
        let mut reports = Vec::new();

        for session in sessions.values() {
            let report = session.detect_leaks().await;
            reports.push(report);
        }

        reports
    }

    /// Get a comprehensive leak detection summary
    pub async fn get_leak_summary(&self) -> LeakSummary {
        let reports = self.detect_all_leaks().await;
        
        let total_sessions = reports.len();
        let sessions_with_leaks = reports.iter().filter(|r| r.has_leaks()).count();
        let total_leaked_resources = reports.iter().map(|r| r.leak_count()).sum();
        let total_resources_created = reports.iter().map(|r| r.total_resources_created).sum();
        
        LeakSummary {
            total_sessions,
            sessions_with_leaks,
            total_leaked_resources,
            total_resources_created,
            detection_time: SystemTime::now(),
            session_reports: reports,
        }
    }

    /// Remove completed or failed sessions
    pub async fn cleanup_finished_sessions(&self) -> CleanupReport {
        let mut sessions = self.sessions.write().await;
        let mut completed = 0;
        let mut failed = 0;
        let mut cancelled = 0;
        let mut to_remove = Vec::new();

        for (id, session) in sessions.iter() {
            let status = session.status().await;
            match status {
                SessionStatus::Completed => {
                    completed += 1;
                    to_remove.push(id.clone());
                }
                SessionStatus::Failed(_) => {
                    failed += 1;
                    to_remove.push(id.clone());
                }
                SessionStatus::Cancelled => {
                    cancelled += 1;
                    to_remove.push(id.clone());
                }
                _ => {}
            }
        }

        for id in &to_remove {
            sessions.remove(id);
            log::debug!("SessionManager: Cleaned up finished session {}", id);
        }

        let total_cleaned = to_remove.len();
        
        log::info!("SessionManager: Cleaned up {} finished sessions ({} completed, {} failed, {} cancelled)", 
                  total_cleaned, completed, failed, cancelled);

        CleanupReport {
            total_cleaned,
            completed,
            failed,
            cancelled,
            cleanup_time: SystemTime::now(),
        }
    }

    /// Get count of sessions by status
    pub async fn session_count_by_status(&self) -> HashMap<SessionStatus, usize> {
        let sessions = self.sessions.read().await;
        let mut counts = HashMap::new();

        for session in sessions.values() {
            let status = session.status().await;
            *counts.entry(status).or_insert(0) += 1;
        }

        counts
    }

    /// Get total number of sessions
    pub async fn total_sessions(&self) -> usize {
        let sessions = self.sessions.read().await;
        sessions.len()
    }

    /// Get all session IDs
    pub async fn list_session_ids(&self) -> Vec<SessionId> {
        let sessions = self.sessions.read().await;
        sessions.keys().cloned().collect()
    }

    /// Get comprehensive manager metrics
    pub async fn get_manager_metrics(&self) -> ManagerMetrics {
        let sessions = self.sessions.read().await;
        let total_sessions = sessions.len();
        let status_counts = drop(sessions);
        let status_counts = self.session_count_by_status().await;
        let leak_summary = self.get_leak_summary().await;

        ManagerMetrics {
            total_sessions,
            status_counts,
            leak_summary,
            last_updated: SystemTime::now(),
        }
    }
}

/// Summary of leak detection across all sessions
#[derive(Debug, Clone)]
pub struct LeakSummary {
    pub total_sessions: usize,
    pub sessions_with_leaks: usize,
    pub total_leaked_resources: usize,
    pub total_resources_created: usize,
    pub detection_time: SystemTime,
    pub session_reports: Vec<LeakDetectionReport>,
}

impl LeakSummary {
    pub fn has_leaks(&self) -> bool {
        self.sessions_with_leaks > 0
    }

    pub fn leak_percentage(&self) -> f64 {
        if self.total_resources_created == 0 {
            0.0
        } else {
            (self.total_leaked_resources as f64 / self.total_resources_created as f64) * 100.0
        }
    }
}

/// Report of session cleanup operations
#[derive(Debug, Clone)]
pub struct CleanupReport {
    pub total_cleaned: usize,
    pub completed: usize,
    pub failed: usize,
    pub cancelled: usize,
    pub cleanup_time: SystemTime,
}

/// Comprehensive metrics for the session manager
#[derive(Debug, Clone)]
pub struct ManagerMetrics {
    pub total_sessions: usize,
    pub status_counts: HashMap<SessionStatus, usize>,
    pub leak_summary: LeakSummary,
    pub last_updated: SystemTime,
}

impl Default for SessionManager {
    fn default() -> Self {
        Self::new(ChannelConfig::default())
    }
}